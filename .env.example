ANTHROPIC_API_KEY=
FAL_KEY=
KIE_API_KEY=
# Which provider runs ALL paid media calls (file upload, avatar try-on,
# picture swap, video face-swap): "fal" or "kie". Both host the same models
# (WAN 2.2 animate/replace, nano-banana edit); pick whichever account has
# credits. Only that provider's key needs to be set.
SWAP_PROVIDER=fal

# Path to the Python interpreter that has the sidecar's deps (python/requirements.txt)
# installed, e.g. a venv: venv/Scripts/python.exe (Windows) or venv/bin/python (Mac/Linux).
# If unset, falls back to the system "python", which usually lacks scrapling installed.
PYTHON_BIN=venv/Scripts/python.exe

# Display label for pipeline runs shown in the UI (e.g. Job, Campaign, Video)
NEXT_PUBLIC_JOB_LABEL=Job
