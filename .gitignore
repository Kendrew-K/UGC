# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json

# python sidecar venv and bytecode
/venv
/.venv
__pycache__/
*.pyc

# generated media: uploads, scraped clips, avatars, rendered output.
# Everything here is reproducible by running the pipeline, and it is hundreds
# of MB, so it never goes in the repo.
/media

# local run logs
*.log
scratch-*.log
